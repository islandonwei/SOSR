#!/bin/gnuplot
set encoding iso_8859_1
set out "18.eps"

set size 1, 0.50
set terminal postscript portrait enhanced mono "Helvetica" 22

set ylabel "Indexing time (s)"
set xlabel "Datasets"
set pointsize 2

set key at 27,780

# 设置柱状图宽度 - 每个柱子宽度为2.6，三个柱子紧邻
set boxwidth 2.6
set style fill solid 0.5 border -1

# Y轴对数刻度设置
set yrange [0 : 800]

# X轴范围和刻度设置 - 4组数据，每组间隔为12
set xrange [0 : 50]
set xtics ("NYC" 5, "BAY" 18, "COL" 31, "FLA" 44) scale 0
set xtics font "Helvetica,20"

# 绘制三个算法的柱状图，每组内三个柱子紧邻（间隔2.6）
plot "18.dat" using ($1-2.6):2 title 'DROMC' with boxes fs solid 0.3, \
     "18.dat" using ($1):3 title 'ROSE' with boxes fs solid 0.5, \
     "18.dat" using ($1+2.6):4 title 'FSSP' with boxes fs solid 0.7
	 
unset output
set size 1,1