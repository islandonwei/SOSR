#!/bin/gnuplot
set encoding iso_8859_1
set out "9.eps"

set size 1.25, 0.50
set terminal postscript portrait enhanced mono "Helvetica" 22

set ylabel "Query time (ms)"
set xlabel "Combinations"
set pointsize 2

set key at 40,804789

# 设置柱状图宽度 - 每个柱子宽度为2.6，三个柱子紧邻
set boxwidth 2.6
set style fill solid 0.5 border -1

# Y轴对数刻度设置
set yrange [0.1 : 1004789]
set log y 10
set format y '10^{%L}'

# X轴范围和刻度设置 - 9组数据，每组间隔为12
set xrange [-6 : 108]
set xtics ("LLL" 0, "LML" 12, "LHL" 24, "MLM" 36, "MMM" 48, "MHM" 60, "HLH" 72, "HMH" 84, "HHH" 96) scale 0
set xtics font "Helvetica,20"

# 绘制三个算法的柱状图，每组内三个柱子紧邻（间隔2.6）
plot "9.dat" using ($1-2.6):2 title 'ROSE' with boxes fs solid 0.3, \
     "9.dat" using ($1):3 title 'DROMC' with boxes fs solid 0.5, \
     "9.dat" using ($1+2.6):4 title 'FSSP' with boxes fs solid 0.7
	 
unset output
set size 1,1