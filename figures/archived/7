#!/bin/gnuplot

set out "7.eps"

set size 1.00, 0.50
set terminal postscript portrait enhanced mono "Helvetica" 22

set ylabel "Query time ({ms)"
set xlabel "{/Courier R_i}"
set pointsize 2

set key at 40,27000

set xtics 10.00
set yrange [1 : 33000.00000000]
set log y 10
set format y '10^{%L}'
set xrange [0 : 50]
set xtics ("R_1" 5, "R_2" 15, "R_3" 25, "R_4" 35, "R_5" 45)

plot "7.dat" using 1:2 title "ROSE" with linespoints linetype 1 pointtype 8,\
"7.dat" using 1:3 title "DROMC" with linespoints linetype 1 pointtype 2,\
"7.dat" using 1:4 title "FSSP" with linespoints linetype 1 pointtype 4


unset output
set size 1,1
